APP_CONFIG=development
FLASK_DEBUG=1
FLASK_USE_RELOADER=0
ENABLE_LEGACY_RESEARCH_ROUTES=0
PORT=5000

# Replace this before any shared or production deployment.
SECRET_KEY=change-this-local-secret

# Defaults already point to instance/mddad.sqlite3 and uploads/ under the repo.
# DATABASE_PATH=D:\path\to\mddad.sqlite3
# UPLOAD_FOLDER=D:\path\to\uploads
MAX_CONTENT_LENGTH=209715200

SEED_DEMO_USER=1
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123

SOCKETIO_ASYNC_MODE=threading
LOG_LEVEL=INFO

# Defaults point to models/driver_safety_v1 under the repo. Override only when
# the binary artifact bundle is stored elsewhere.
# DRIVER_SAFETY_MODEL_DIR=D:\path\to\driver_safety_v1
# DRIVER_SAFETY_FACE_DETECTOR_PATH=D:\path\to\face_detection.pt
# DRIVER_SAFETY_FACE_VERIFIER_PATH=D:\path\to\face_verification.h5
# DRIVER_SAFETY_DROWSINESS_MODEL_PATH=D:\path\to\best_model.h5
# DRIVER_SAFETY_SCALER_PATH=D:\path\to\scaler.joblib
# DRIVER_SAFETY_FACE_ENROLLMENT_DIR=D:\path\to\uploads\face_enrollment

DRIVER_SAFETY_FACE_CONFIDENCE=0.251
DRIVER_SAFETY_FACE_IMGSZ=640
DRIVER_SAFETY_FACE_DETECTOR_FPS=2.0
DRIVER_SAFETY_FACE_DEVICE=auto
DRIVER_SAFETY_DROWSINESS_OPENVINO_PATH=models/driver_safety_v1/openvino/drowsiness.xml
DRIVER_SAFETY_FACE_VERIFIER_OPENVINO_PATH=models/driver_safety_v1/openvino/face_verification.xml
DRIVER_SAFETY_FACE_VERIFY_THRESHOLD=0.94
DRIVER_SAFETY_SEQUENCE_LENGTH=15
DRIVER_SAFETY_INFERENCE_STRIDE=2
DRIVER_SAFETY_FEATURE_GAP_RESET_SECONDS=0.25
DRIVER_SAFETY_DECISION_THRESHOLD=0.5
DRIVER_SAFETY_ALERT_THRESHOLD=0.7
DRIVER_SAFETY_EVENT_CONFIRM_SECONDS=3.0
DRIVER_ACTION_DEVICE=auto
DRIVER_ACTION_WINDOW_SIZE=16
DRIVER_ACTION_SAMPLE_STRIDE_FRAMES=2
DRIVER_ACTION_INFERENCE_STRIDE=1
DRIVER_ACTION_LABEL_SMOOTHING_FRAMES=15
DRIVER_ACTION_CONFIDENCE_THRESHOLD=0.45
DRIVER_ACTION_EVENT_CONFIRM_SECONDS=2.0

REALTIME_CAMERA_INDEX=0
REALTIME_CAMERA_WIDTH=640
REALTIME_CAMERA_HEIGHT=480
REALTIME_TARGET_FPS=30
REALTIME_IDLE_FEED_FPS=12
REALTIME_PREVIEW_MAX_FPS=12
REALTIME_PREVIEW_WIDTH=640
REALTIME_PREVIEW_JPEG_QUALITY=72
REALTIME_ENABLE_SNAPSHOT_PREVIEW=1
REALTIME_SNAPSHOT_FPS=3
REALTIME_SNAPSHOT_WIDTH=320
REALTIME_ENABLE_EVENT_EVIDENCE=1
REALTIME_PHONE_DETECTOR_BACKEND=disabled
REALTIME_YOLO_CONFIDENCE_THRESHOLD=0.35
REALTIME_PHONE_CONTEXT_FILTER=1
MAR_THRESHOLD=0.60
YAWN_MIN_DURATION=1.2
LOOKING_AWAY_MIN_DURATION=1.5
HEAD_DOWN_MIN_DURATION=1.2
FACE_LOOKING_AWAY_OFFSET_THRESHOLD=0.07
FACE_HEAD_DOWN_OFFSET_THRESHOLD=0.08
FACE_BEHAVIOR_CALIBRATION_SAMPLES=20
